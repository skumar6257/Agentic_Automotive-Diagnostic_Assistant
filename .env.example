# ==========================================
# AUTOMOTIVE DIAGNOSTIC ASSISTANT CONFIG
# ==========================================

# Active Deployment Mode: 'CLOUD' or 'OFFLINE'
DEPLOYMENT_MODE=CLOUD

# ==========================================
# MODE A: CLOUD CONFIGURATION (GCP / Vertex AI)
# ==========================================
# Google Cloud Platform settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Neo4j AuraDB (Cloud Managed Graph)
AURA_DB_URI=neo4j+s://<your-aura-id>.databases.neo4j.io
AURA_DB_USER=neo4j
AURA_DB_PASSWORD=your-aura-password

# Qdrant Cloud (Cloud Vector DB)
QDRANT_CLOUD_URL=https://your-cluster.qdrant.tech:6333
QDRANT_CLOUD_API_KEY=your-qdrant-api-key

# ==========================================
# MODE B: OFFLINE CONFIGURATION (Local Edge)
# ==========================================
# vLLM Local Server (GPU)
VLLM_API_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-sk-key  # Usually dummy key for local vLLM
VLLM_LOCAL_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct

# Ollama Local Server - CPU (Replacing vLLM)
OLLAMA_API_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama  # Dummy key
OLLAMA_LOCAL_MODEL_NAME=llama3.1

# Local Neo4j Community Edition
LOCAL_GRAPH_URI=bolt://localhost:7687
LOCAL_GRAPH_USER=neo4j
LOCAL_GRAPH_PASSWORD=localpassword

# Qdrant / Milvus Local Vector DB
LOCAL_VECTOR_URL=http://localhost:6333
LOCAL_VECTOR_API_KEY=  # Leave blank if no auth locally

# Frontend API Endpoints
LOCAL_API_URL=http://localhost:8000/diagnose
CLOUD_API_URL=https://agentic-diagnostic-api-xyz.run.app/diagnose

